{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Profiles",
  "version": "0.1.0",
  "identifier": "dev.jz.claude-profiles",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Claude Profiles",
        "width": 1040,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "nsis"
    ]
  }
}